    "allow": [
      "Bash(gh issue comment *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(git fetch *)",
      "Bash(git push --force-with-lease origin feature/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npx npm@11 install)"
