      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:test*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin main*)",
      "Bash(git push origin test*)",
      "Bash(git worktree unlock *)",
      "Bash(gradle -p android assembleRelease*)",
      "Bash(gradle -p android bundleRelease*)",
      "Bash(killall *)",
      "Bash(npm publish*)",
      "Bash(npm run amplify-push*)",
      "Bash(npm run android*)",
      "Bash(npm run android:bundle*)",
      "Bash(npm run android:prod*)",
      "Bash(npm run build:android*)",
      "Bash(npx ampx pipeline-deploy *)",
      "Bash(npx cdk deploy*)",
      "Bash(npx expo run:android*)",
      "Bash(pkill *)",
      "Bash(sam deploy*)",
      "Edit(**/.claude/evidence/*/pids)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/racimo-harness-layer.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.git/config)",
      "Edit(**/.git/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env.*.local)",
      "Read(**/.env.backup)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.local)",
      "Read(**/.env.preview)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.qa)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.uat)",
      "Read(**/.envrc)",
      "Read(**/keystore.properties)",
      "Read(**/team-provider-info.json)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.local)",
      "Read(~/.aws/**)",
      "Read(~/.aws/cli/**)",
      "Read(~/.aws/sso/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Write(**/.claude/evidence/*/pids)",
      "Write(**/.claude/hooks/**)",
      "Write(**/.claude/racimo-harness-layer.json)",
      "Write(**/.claude/settings.json)",
      "Write(**/.claude/settings.local.json)",
      "Write(**/.git/config)",
      "Write(**/.git/hooks/**)",
      "Write(~/.claude/settings.json)"
