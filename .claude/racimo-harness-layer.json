{
  "version": "1.1.2",
  "guard": 2,
  "profile": "UVA-App-Frontend",
  "source": "https://github.com/MakeSens-Apps/racimo-harness",
  "managed": {
    "deny": [
      "Bash(./gradlew assembleRelease*)",
      "Bash(./gradlew bundleRelease*)",
      "Bash(./gradlew publish*)",
      "Bash(amplify publish*)",
      "Bash(amplify push*)",
      "Bash(ampx pipeline-deploy *)",
      "Bash(aws amplify start-job *)",
      "Bash(aws amplify update-app *)",
      "Bash(aws amplify update-branch *)",
      "Bash(aws cognito-idp admin-*)",
      "Bash(cdk deploy*)",
      "Bash(expo run:android*)",
      "Bash(gh auth switch*)",
      "Bash(gh auth token*)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh pr review --approve*)",
      "Bash(gh release create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh run rerun *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow run *)",
      "Bash(git credential *)",
      "Bash(git push --delete *)",
      "Bash(git push --force origin *)",
      "Bash(git push --mirror*)",
      "Bash(git push --tags*)",
      "Bash(git push -f *)",
