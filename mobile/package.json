{
  "name": "mobile",
  "version": "2.3.1",
  "main": "index.ts",
  "dependencies": {
    "@aws-amplify/datastore": "^5.1.8",
    "@aws-amplify/react-native": "^1.3.3",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "aws-amplify": "^6.18.0",
    "date-fns": "^4.4.0",
    "expo": "~56.0.11",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "^56.0.18",
    "expo-clipboard": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-file-system": "^56.0.8",
    "expo-font": "~56.0.6",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "~56.0.17",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "~56.0.17",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.78.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "4.3.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.2",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^56.0.15",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.4",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "build:android:apk": "npm run prebuild:android && cd android && ./gradlew assembleRelease --no-daemon",
    "build:android:aab": "npm run prebuild:android && cd android && ./gradlew bundleRelease --no-daemon",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "prepare": "P=$(git rev-parse --show-prefix) && cd \"$(git rev-parse --show-toplevel)\" && husky \"$P.husky\" || true"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|aws-amplify|@aws-amplify|uuid|@gorhom/bottom-sheet|react-native-render-html|react-native-toast-message)"
    ],
    "moduleNameMapper": {
      "amplifyconfiguration\\.json$": "<rootDir>/src/__tests__/__mocks__/amplify-config-mock.json",
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js",
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/mock",
      "^@expo/vector-icons(.*)$": "<rootDir>/__mocks__/expoVectorIconsMock.js"
    },
    "setupFiles": [
      "<rootDir>/src/__tests__/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/__tests__/jest.setup.js"
    ]
  },
  "private": true
}
